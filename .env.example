# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# AWS Configuration
VITE_AWS_REGION=eu-central-1
VITE_AWS_ACCESS_KEY_ID=your_access_key
VITE_AWS_SECRET_ACCESS_KEY=your_secret_key
VITE_AWS_S3_BUCKET=your_bucket_name
VITE_AWS_LAMBDA_ENDPOINT=https://your-lambda-endpoint.amazonaws.com

# Shipping API Keys (Optional)
VITE_UPS_API_KEY=your_ups_key
VITE_FEDEX_API_KEY=your_fedex_key
VITE_DHL_API_KEY=your_dhl_key

# Domain Configuration
VITE_APP_DOMAIN=your-domain.com
VITE_APP_NAME=ConceptSHOP
